RewriteEngine On

# ১. কেউ সরাসরি .php লিখে ভিজিট করলে .php সরিয়ে রিডাইরেক্ট করবে
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s([^.]+)\.php [NC]
RewriteRule ^ %1 [R=301,L]

# ২. .php ছাড়াই পেজ লোড করার জন্য ইন্টারনাল রাউটিং
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^(.*)$ $1.php [L]