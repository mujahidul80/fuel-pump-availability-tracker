{
  "version": 2,
  "functions": {
    "*.php": {
      "runtime": "vercel-php@0.7.2"
    },
    "admin/*.php": {
      "runtime": "vercel-php@0.7.2"
    }
  },
  "routes": [
    {
      "src": "/admin/(.*)",
      "dest": "/admin/index.php"
    },
    {
      "src": "/admin",
      "dest": "/admin/index.php"
    },
    {
      "src": "/style.css",
      "dest": "/style.css"
    },
    {
      "src": "/script.js",
      "dest": "/script.js"
    },
    {
      "src": "/uploads/(.*)",
      "dest": "/uploads/$1"
    },
    {
      "src": "/details",
      "dest": "/details.php"
    },
    {
      "src": "/install",
      "dest": "/install.php"
    },
    {
      "src": "/setup",
      "dest": "/setup.php"
    },
    {
      "src": "/(.*)",
      "dest": "/index.php"
    }
  ]
}
